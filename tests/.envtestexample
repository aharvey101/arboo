# E2E Test Environment Configuration
# Copy this to .env.test and customize for your testing environment

# WebSocket URL for testing (use a reliable public endpoint or local node)
TEST_WS_URL=ws://192.168.0.14:8547

# HTTP URL for testing (for transaction submission tests)
TEST_HTTP_URL=https://eth.merkle.io

# Test timeout in seconds
TEST_TIMEOUT_SECS=30

# Whether to use local fork for testing (requires Anvil)
USE_LOCAL_FORK=false

# Fork block number (if using local fork)
FORK_BLOCK_NUMBER=18500000

# Test contract addresses (will be deployed during tests)
TEST_CONTRACT_ADDRESS=

# Test private key (for test networks only - never use mainnet keys!)
TEST_PRIVATE_KEY=

# Enable verbose test logging
TEST_VERBOSE=true
